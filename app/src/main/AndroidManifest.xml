<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network / socket access -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Termux integration: user must grant this in Android Settings. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Keep the foreground process alive while CONNECT is active -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 13+ runtime notification permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Not needed on Android < 16; harmless to declare for forward compatibility.
         Enables discovery/bind on the local network when LAN mode is on. -->
    <uses-permission
        android:name="android.permission.ACCESS_LOCAL_NETWORK"
        tools:targetApi="36" />

    <!-- Android 11+ package visibility for detecting Termux. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".NineRouterApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${labelName}"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.NineRouter"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NineRouter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.NineRouter" />

        <!--
            The persistent foreground service that owns the local 9Router process.
            type = dataSync + specialUse so it may run persistently; the special-use
            subtype is declared below. Disconnect/Restart/Dashboard are its actions.
        -->
        <service
            android:name=".service.RouterForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local self-hosted AI router serving an OpenAI-compatible API on the device" />
        </service>

    </application>

</manifest>
